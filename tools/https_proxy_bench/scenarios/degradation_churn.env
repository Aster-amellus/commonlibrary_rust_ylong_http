SCENARIO_NAME=degradation_churn
SCENARIO_LAYER=degradation
CLIENT_FILTER=ylong
URL=https://127.0.0.1:18080/
PROXY=https://127.0.0.1:18443
REQUESTS=200000
WARMUP=8192
CONCURRENCY=2048
READ_BUFFER_SIZE=65536
ORIGIN_TLS=1
RESPONSE_SIZE=4096
ORIGIN_DELAY_MS=1
ORIGIN_CLOSE_EVERY_N_REQUESTS=100
YLONG_CLIENT_MODE=shared
YLONG_MAX_H1_CONN_NUMBER=256
YLONG_PHASE_METRICS=1
PROFILE=perf-stat
PERF_EVENTS=task-clock,cycles,instructions,cache-misses,context-switches,cpu-migrations,page-faults
REPEAT=3

SCENARIO_NAME=enterprise_mixed_pressure
SCENARIO_LAYER=enterprise-pressure
CLIENT_FILTER=both
URL=https://127.0.0.1:18080/
PROXY=https://127.0.0.1:18443
REQUESTS=300000
WARMUP=32768
CONCURRENCY=1024
READ_BUFFER_SIZE=65536
ORIGIN_TLS=1
RESPONSE_SIZE=1024
RESPONSE_SIZE_SEQUENCE=1024,4096,16384,65536,262144
ORIGIN_DELAY_MS=1
YLONG_CLIENT_MODE=shared
YLONG_MAX_H1_CONN_NUMBER=1024
PROFILE=perf-stat
PERF_EVENTS=task-clock,cycles,instructions,cache-misses,context-switches,cpu-migrations,page-faults
REPEAT=5

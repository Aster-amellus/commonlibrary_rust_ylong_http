SCENARIO_NAME=correctness_https_proxy_mtls
SCENARIO_LAYER=correctness
CLIENT_FILTER=both
URL=https://127.0.0.1:18080/
PROXY=https://127.0.0.1:18443
REQUESTS=2000
WARMUP=128
CONCURRENCY=64
READ_BUFFER_SIZE=65536
ORIGIN_TLS=1
PROXY_REQUIRE_CLIENT_CERT=1
RESPONSE_SIZE=1024
ORIGIN_DELAY_MS=0
YLONG_CLIENT_MODE=shared
YLONG_MAX_H1_CONN_NUMBER=64
PROFILE=
PERF_EVENTS=task-clock,cycles,instructions,cache-misses,context-switches,cpu-migrations,page-faults
REPEAT=1
